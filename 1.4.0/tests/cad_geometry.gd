extends Node3D
const Document = preload("res://cad/CADDocument.gd")
var checks := 0
var failures := 0
func check(ok: bool, label: String):
	checks += 1
	if not ok: failures += 1; push_error("CAD FAIL: "+label)
	else: print("CAD PASS: "+label)
func _ready():
	var doc = Document.new()
	add_child(doc)
	var id: int = doc.new_sketch(Transform3D.IDENTITY)
	doc.set_profile(id,"rectangle",[[0,0],[20,15]])
	check(await doc.extrude(id,10,"New"),"40 x 30 x 10 mm New extrusion")
	if doc.bodies.is_empty(): get_tree().quit(1); return
	check(absf(Document.volume(doc.bodies[0].faces)-12000)<0.1,"new volume is 12000 mm3")
	var body_id: int = doc.bodies[0].id
	var cut: int = doc.new_sketch(Transform3D.IDENTITY,body_id)
	doc.set_profile(cut,"circle",[[0,0],[5,0]])
	check(await doc.extrude(cut,10,"Remove"),"circle Remove extrusion through body")
	var expected := 12000.0-96*sin(TAU/96.0)*25/2.0*10
	check(absf(Document.volume(doc.bodies[0].faces)-expected)<1,"hole volume matches tessellated 5 mm radius")
	var saved: Dictionary = doc.snapshot()
	check(Document.validate(saved).is_empty(),"CAD snapshot validates")
	doc.undo()
	check(absf(Document.volume(doc.bodies[0].faces)-12000)<0.1,"undo restores pre-cut volume")
	doc.redo()
	check(absf(Document.volume(doc.bodies[0].faces)-expected)<1,"redo restores hole")
	doc.load_document(saved)
	check(doc.sketches.size()==2 and doc.bodies.size()==1,"sketch attachments restore")
	var add: int = doc.new_sketch(Transform3D(Basis.IDENTITY,Vector3(0,0,10)),body_id)
	doc.set_profile(add,"rectangle",[[0,0],[10,10]])
	check(await doc.extrude(add,5,"Add"),"Add extrusion on existing face")
	check(absf(Document.volume(doc.bodies[0].faces)-(expected+2000))<1,"Add union has expected volume")
	check(await doc.dimension(cut,"radius",6),"edit extruded circle radius")
	var new_expected:=12000.0-96*sin(TAU/96.0)*36/2.0*10+2000
	check(absf(Document.volume(doc.bodies[0].faces)-new_expected)<1,"dimension edit rebuilds downstream solid features")
	# A repeated cut should be a no-op, not another noisy boolean feature.
	var cut_features: int=doc.bodies[0].features.size()
	check(not await doc.extrude(cut,10,"Remove"),"repeated cut rejects unchanged geometry")
	check(doc.bodies[0].features.size()==cut_features,"no-op does not append feature history")
	# Base planes and translation preserve metric geometry independently of the viewer.
	check(doc.base_plane("Top").basis.z.is_equal_approx(Vector3.UP),"Top plane normal is world up")
	check(doc.base_plane("Front").basis.z.is_equal_approx(Vector3.BACK),"Front plane orientation")
	check(doc.base_plane("Right").basis.z.is_equal_approx(Vector3.RIGHT),"Right plane orientation")
	var v_before: float=Document.volume(doc.bodies[0].faces)
	var first: Array=doc.bodies[0].faces[0].duplicate()
	var old_origin: Vector3=doc.origin_mm
	doc.move_origin(old_origin+Vector3(125,-20,80))
	check(absf(Document.volume(doc.bodies[0].faces)-v_before)<0.1,"moving origin preserves solid volume")
	check(absf(doc.bodies[0].faces[0][0]-first[0]-125)<0.001,"moving origin translates cached geometry")
	check(doc.base_plane("Top").basis.z.is_equal_approx(Vector3.UP),"moved Top plane stays ground-parallel")
	# Automatic inference and retained directional relationships.
	var constraints=Document.new()
	add_child(constraints)
	var base: int=constraints.new_sketch(Transform3D.IDENTITY)
	constraints.set_profile(base,"line",[[10,10],[50,10]],false)
	var follower: int=constraints.new_sketch(Transform3D.IDENTITY)
	constraints.set_profile(follower,"line",[[80,20]],false)
	var inferred: Dictionary=constraints.infer_point(follower,Vector2(50.1,10.1),1)
	check(inferred.constraint.get("kind")=="coincident" and inferred.point.distance_to(Vector2(50,10))<0.001,"automatic endpoint coincidence")
	inferred=constraints.infer_point(follower,Vector2(30.1,10.1),1)
	check(inferred.constraint.get("kind")=="midpoint","automatic line midpoint")
	constraints.set_profile(follower,"line",[[30,10],[80,35]],false)
	constraints.add_inference(follower,0,{"kind":"midpoint","target":base,"index":0})
	check(await constraints.dimension(base,"length",60),"driving line length")
	check(Vector2(constraints.sketch(follower).points[0][0],constraints.sketch(follower).points[0][1]).distance_to(Vector2(40,10))<0.001,"midpoint relationship follows dimension edit")
	constraints.clear_constraints(follower)
	constraints.set_profile(follower,"line",[[80,20]],false)
	check(constraints.infer_point(follower,Vector2(100,20.2),1).constraint.get("kind")=="horizontal","automatic horizontal")
	check(constraints.infer_point(follower,Vector2(80.1,40),1).constraint.get("kind")=="vertical","automatic vertical")
	var slant: int=constraints.new_sketch(Transform3D.IDENTITY)
	constraints.set_profile(slant,"line",[[10,50],[30,70]],false)
	check(constraints.infer_point(follower,Vector2(100,40.1),1).constraint.get("kind")=="parallel","automatic parallel")
	check(constraints.infer_point(follower,Vector2(100,-0.1),1).constraint.get("kind")=="perpendicular","automatic perpendicular")
	check(constraints.infer_point(follower,Vector2(98,41.8),1).constraint.get("kind")=="equal","automatic equal length")
	var circle: int=constraints.new_sketch(Transform3D.IDENTITY)
	constraints.set_profile(circle,"circle",[[150,20],[155,20]],true)
	check(constraints.infer_point(follower,Vector2(150.1,20.1),1).constraint.get("kind")=="coincident","automatic circle center coincidence")
	var tangent: int=constraints.new_sketch(Transform3D.IDENTITY)
	constraints.set_profile(tangent,"line",[[160,20]],false)
	check(constraints.infer_point(tangent,Vector2(152.5,24.330127),0.2).constraint.get("kind")=="tangent","automatic line-circle tangency")
	var invalid: Dictionary=constraints.snapshot()
	invalid.sketches[1].constraints=[{"kind":"midpoint","point":0,"target":999,"index":0}]
	check(not Document.validate(invalid).is_empty(),"reject missing constraint target")
	invalid=constraints.snapshot()
	invalid.origin_mm=[0,0]
	check(not Document.validate(invalid).is_empty(),"reject malformed origin")
	invalid=constraints.snapshot()
	invalid.sketches[0].plane[0]=2
	check(not Document.validate(invalid).is_empty(),"reject scaled sketch plane")
	var crossing: int=constraints.new_sketch(Transform3D.IDENTITY)
	constraints.set_profile(crossing,"line",[[0,0],[10,10],[0,10],[10,0]],true)
	check(not await constraints.extrude(crossing,10,"New"),"reject self-crossing profile")
	print("CAD RESULT: %d checks, %d failures" % [checks,failures])
	get_tree().quit(0 if failures==0 else 1)
