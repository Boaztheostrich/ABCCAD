extends "res://main.gd"
var failures:=0
var checks:=0
func check(ok: bool, description: String):
	checks+=1
	if not ok: failures+=1; push_error("WHEEL FAIL: "+description)
	else: print("WHEEL PASS: "+description)
func item(wb: Node3D, id: String) -> Dictionary:
	for entry in wb.wheel_context().items:
		if entry.id==id:return entry
	return {}
func _ready():
	super._ready()
	for i in 4: await get_tree().process_frame
	var wb=get_node("AdvancedCAD")
	wb.enabled=true; wb.open_panel(); wb.set_process(false)
	var wheel=wb.command_wheel
	wheel.set_process(false)
	check(wheel.update_input(Vector2.ZERO,true,0.1,true)==-1,"center click does nothing")
	for count in [4,6,8]:
		for index in count:
			wheel.update_input(Vector2.ZERO,false,0.1,true,count)
			var angle: float=index*TAU/count
			var axis:=Vector2(sin(angle),cos(angle))
			check(wheel.update_input(axis,false,0.1,true,count)==-1 and wheel.selected==index,"%d-way tilt previews wedge %d without executing" % [count,index])
			check(wheel.update_input(axis,true,0.1,true,count)==index,"%d-way click selects wedge %d" % [count,index])
			check(wheel.update_input(axis,false,0.1,true,count)==-1 and wheel.update_input(axis,true,0.1,true,count)==-1,"requires neutral before another action")
	wheel.update_input(Vector2.ZERO,false,0.1,true,8)
	wheel.update_input(Vector2(0,1),false,0.1,true,8)
	check(wheel.update_input(Vector2.RIGHT,true,0.01,true,8)==0,"click-induced nudge keeps previewed selection")
	wheel.update_input(Vector2.ZERO,false,0.1,true,8)
	wheel.update_input(Vector2(0,1),false,0.1,true,8)
	wheel.update_input(Vector2.from_angle(PI/2-PI/8-0.02),false,0.2,true,8)
	check(wheel.selected==0,"angular hysteresis prevents boundary flicker")
	wheel.update_input(Vector2(1,1),false,0.01,true,8)
	check(wheel.selected==0,"new direction waits for settling interval")
	wheel.update_input(Vector2(1,1),false,0.1,true,8)
	check(wheel.selected==1,"settled diagonal selects its own wedge")
	wheel.update_input(Vector2.ZERO,false,0.1,true,8)
	check(not wheel._open and wheel.selected==-1,"neutral cancels preview")
	wheel.update_input(Vector2.RIGHT,true,0.1,false,8)
	check(wheel.update_input(Vector2.RIGHT,true,0.1,true,8)==-1,"tracking recovery cannot activate held input")
	wb.document.clear_all();wb.active_sketch=-1;wb.selected_hit={};wb.ui.show_command("select")
	var studio: Dictionary=wb.wheel_context()
	check(studio.id=="studio" and studio.items.size()==4,"part studio has a compact four-choice wheel")
	wb.run_wheel_command("circle")
	check(wb.active_sketch==-1,"command absent from live context is ignored")
	wb.run_wheel_command("sketch")
	check(wb.tool=="plane_select" and wb.wheel_context().id=="plane","new sketch offers a dedicated plane wheel")
	var plane_menu: Dictionary=wb.wheel_context()
	wheel.set_menu(studio)
	wheel.update_input(Vector2(0,1),false,0.1,true,4)
	wheel.set_menu(plane_menu,Vector2(0,1),false)
	check(not wheel._open and wheel.update_input(Vector2(0,1),true,0.1,true,4)==-1,"context change closes menu and requires neutral")
	wheel.update_input(Vector2.ZERO,false,0.1,true,4)
	wheel.update_input(Vector2(0,1),false,0.1,true,4)
	check(wheel.update_input(Vector2(0,1),true,0.1,true,4)==0,"neutral rearms changed layout")
	wb.run_wheel_command("plane_front")
	var sketch_menu: Dictionary=wb.wheel_context()
	check(sketch_menu.id=="sketch" and sketch_menu.items.size()==8,"active sketch exposes exactly eight choices")
	check(sketch_menu.items[4].id=="extrude" and sketch_menu.items[6].id=="dimension","Extrude stays down and Dimension stays left")
	check(not item(wb,"extrude").enabled,"open sketch dims Extrude")
	wb.run_wheel_command("extrude")
	check(wb.ui.mode=="sketch","disabled action cannot run")
	for command in ["circle","rectangle","line"]:
		wb.run_wheel_command(command)
		check(wb.tool==command and wb.ui.mode=="sketch","wheel starts existing %s drawing tool" % command)
	check(item(wb,"line").active,"current tool has an active marker")
	wb.run_wheel_command("finish_tool")
	check(wb.tool=="select" and not item(wb,"finish_tool").enabled,"Finish Tool ends drawing without leaving sketch")
	wb.document.set_profile(wb.active_sketch,"rectangle",[[0,0],[20,15]],true)
	check(item(wb,"dimension").enabled and item(wb,"extrude").enabled,"closed shape enables dimension and extrusion")
	wb.run_wheel_command("dimension")
	check(wb.ui.mode=="sketch" and wb.tool=="select","Dimension uses existing label-editing workflow")
	wb.run_wheel_command("use_edge")
	check(wb.tool=="use_edge","Use Edge starts projection")
	wb.run_wheel_command("extrude")
	check(wb.ui.mode=="extrude" and wb.selected_regions.size()==1 and wb.extrude_arrow.visible,"Extrude auto-selects sole region and exposes arrow")
	check(wb.wheel_context().items.size()==6,"extrusion has a focused six-choice wheel")
	check(not item(wb,"operation_add").enabled and not item(wb,"operation_remove").enabled,"Add and Remove require a selected part")
	var depth: float=wb.depth_mm
	wb.run_wheel_command("reverse")
	check(is_equal_approx(wb.depth_mm,-depth),"Reverse flips signed depth")
	wb.run_wheel_command("reverse")
	await wb.run_wheel_command("apply_extrude")
	check(wb.document.bodies.size()==1 and wb.ui.mode=="select","Apply commits extrusion and returns to part studio")
	var source: Dictionary=wb.document.body(wb.selected_body)
	var first: Array=source.faces[0]
	var a:=Vector3(first[0],first[1],first[2])
	var second: Array=source.faces[1];var third: Array=source.faces[2]
	var normal: Vector3=(Vector3(second[0],second[1],second[2])-a).cross(Vector3(third[0],third[1],third[2])-a).normalized()
	wb.selected_hit={"source":source,"point_mm":a,"point":a*0.001,"normal":normal,"triangle":0}
	wb._refresh_ui()
	check(wb.wheel_context().id=="face" and wb.wheel_context().items.size()==4,"selected face has four relevant choices")
	wb.run_wheel_command("sketch_face")
	check(wb.ui.mode=="sketch" and wb.document.sketch(wb.active_sketch).body_id==wb.selected_body,"Sketch on Face attaches sketch to selected solid")
	wb.document.set_profile(wb.active_sketch,"circle",[[0,0],[3,0]],true)
	wb.run_wheel_command("extrude")
	check(item(wb,"operation_add").enabled and item(wb,"operation_remove").enabled,"attached sketch enables Add and Remove")
	wb.run_wheel_command("operation_remove")
	check(wb.operation=="Remove" and item(wb,"operation_remove").active,"operation choices set state and active marker")
	wb.run_wheel_command("edit_sketch")
	check(wb.ui.mode=="sketch" and wb.wheel_context().items.size()==8,"Edit Sketch restores drawing wheel")
	var other: int=wb.document.new_entity(wb.active_sketch,"circle")
	wb.document.set_profile(other,"circle",[[60,0],[65,0]],true)
	wb.selected_regions.clear()
	wb.run_wheel_command("extrude")
	check(wb.regions().size()>1 and wb.selected_regions.is_empty() and not wb.extrude_arrow.visible,"multiple regions still require selection before the arrow")
	wb.ui.show_command("sketch")
	var tracker:=XRPositionalTracker.new()
	tracker.type=XRServer.TRACKER_CONTROLLER;tracker.name="right_hand"
	tracker.set_pose("default",Transform3D(Basis.IDENTITY,Vector3(0.3,1.4,-0.5)),Vector3.ZERO,Vector3.ZERO,XRPose.XR_TRACKING_CONFIDENCE_HIGH)
	tracker.set_input("primary",Vector2.ZERO);tracker.set_input("primary_click",false)
	XRServer.add_tracker(tracker)
	for i in 3: await get_tree().physics_frame;await get_tree().process_frame
	check(wb.right.get_is_active(),"real XR controller receives synthetic tracked input")
	wheel._process(0.1)
	tracker.set_input("primary",Vector2(0.8,0.8))
	wheel._process(0.1)
	check(wheel.selected==1 and wheel.face.menu.items.size()==8,"native right stick previews center circle in sketch wheel")
	tracker.set_input("primary_click",true)
	wheel._process(0.1)
	check(wb.tool=="circle","native right-stick click dispatches center-circle tool")
	tracker.set_input("primary",Vector2.ZERO);tracker.set_input("primary_click",false)
	wheel._process(0.1)
	wb.ui.keypad.visible=true
	tracker.set_input("primary",Vector2.RIGHT);tracker.set_input("primary_click",true)
	wheel._process(0.1)
	check(not wheel._open and wb.tool=="circle","numeric-entry dialog suppresses wheel input")
	wb.ui.keypad.visible=false
	XRServer.remove_tracker(tracker)
	wb.close_panel()
	var before: String=wb.tool
	wb.run_wheel_command("edit_sketch")
	check(wb.tool==before,"closed workspace ignores commands")
	print("WHEEL RESULT: ",checks," checks, ",failures," failures")
	get_tree().quit(1 if failures else 0)
